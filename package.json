{
  "name": "slcl",
  "version": "0.1.0",
  "description": "SLCL (SLATT Client) - a Minecraft Java Edition launcher",
  "author": "SLATT",
  "license": "MIT",
  "main": "./out/main/index.js",
  "overrides": {
    "@xmcl/yauzl": "^2.10.0",
    "@xmcl/unzip": {
      "@xmcl/yauzl": "^2.10.0"
    },
    "@xmcl/system": {
      "@xmcl/yauzl": "^2.10.0",
      "@xmcl/unzip": "^2.2.0"
    }
  },
  "scripts": {
    "postinstall": "node scripts/patch-xmcl.cjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@xmcl/core": "^2.16.2",
    "@xmcl/user": "^4.4.2",
    "electron-store": "^12.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
